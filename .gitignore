# ===== Secrets & environment (NEVER commit — repo is public) =====
.env
.env.*
!.env.example
!**/.env.example

# ===== Terraform (state & tfvars hold DB creds / API keys in plaintext) =====
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# ===== Node / Next.js =====
node_modules/
.next/
out/
.vercel/
*-debug.log*

# ===== Go / Lambda build output (scripts/init.sh is NOT affected) =====
*.exe
*.exe~
*.test
*.out
bootstrap

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ===== Build / deploy artifacts =====
*.zip
dist/
build/

# ===== HiveMind: scratchpad-generated delivery scripts & backups =====
install-*.sh
patch-*.py
**/.redesign-backup/
.gitignore.bak

# ===== OS / editor =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===== Large data & artifacts (tai/regenerate qua scripts/init.sh) =====
data/raw/*
!data/raw/.gitkeep
*.log
