# AWS 
# AWS_PROFILE=hivemind
AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGION_BEDROCK=ap-southeast-1
AWS_REGION_EMBED=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=



# CockroachDB secrets
DATABASE_URL="postgresql://user:pass@cluster.crdb.io:26257/hivemind?sslmode=verify-full"
COCKROACHDB_MCP_ENDPOINT=
COCKROACHDB_MCP_API_KEY=
COCKROACHDB_CLUSTER_ID=
COCKROACHDB_DATABASE=hivemind
MCP_TIMEOUT_SECONDS=

# LLM Model IDs
TITAN_MODEL_ID  = ""
CLAUDE_MODEL_ID = ""

# Worker / Reaper tuning
WORKER_POLL_INTERVAL_SECONDS=2
REAPER_STUCK_THRESHOLD_SECONDS=30

# CockroachDB connection pool size per process (default 10 if unset). Every
# Lambda in the fleet opens its own pool against the same cluster, so raise
# this only after checking the cluster's total connection budget.
COCKROACH_MAX_CONNS=

# Control-plane auth: required header value for mutating /control/* and
# /reviews/* endpoints. Leave unset only for local/offline demos - a deployed
# dashboard-api Function URL is public, so this is the only thing standing
# between the internet and rollback/region/memory/review mutations.
CONTROL_TOKEN=

# Scoring API (Go -> Python bridge)
PYTHON_SCORING_ENDPOINT=http://localhost:8001/score
PORT=8080